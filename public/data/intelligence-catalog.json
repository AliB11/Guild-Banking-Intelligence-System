  "briefing": {
    "period": "1405-05",
    "periodLabel": "مرداد ۱۴۰۵",
    "headline": "مرداد ۱۴۰۵: رشد مبلغ شبکه شاپرک",
    "narrative": [
      "آخرین ماهنامه منتشرشده شاپرک مرداد ۱۴۰۵ (گزارش ۱۳۴) است. گردش شبکه ۳٬۶۵۴ همت و تعداد تراکنش ۴٫۶۵ میلیارد نقل شده. شهریور در تقویم است اما گزارش ندارد.",
      "بازتاب MoM مرداد: مبلغ ۷٫۳٪ و تعداد ۳٪. فاصله ۴٫۳٪ یعنی سبد شبکه سنگین‌تر شده، نه لزوماً اینکه فروشگاه بیشتری آمده.",
      "کارتخوان ۲٬۷۷۶ همت با سبد اعلامی ۶۹۴ هزار تومان؛ اینترنت ۸۶۰ همت با سبد حاصل‌تقسیم ۳٫۲ میلیون تومان. سبد اینترنت چند برابر کارتخوان است.",
      "سهم ملت ۱۸٫۷۹٪ تعداد و ۱۹٫۹۵٪ مبلغ است؛ حاصل‌ضرب در جمع شبکه حدود ۷۲۹ همت می‌شود — شاپرک رقم مطلق ملت را جدا نداده. رشد اسمی سالانه مبلغ ۹۳٫۷٪ و رشد واقعی حدود ۲٫۵٪ نقل شده."
    ],
    "highlights": [
      {
        "title": "گردش شاپرک",
        "detail": "۳٬۶۵۴ همت (۷٫۳٪ MoM نقل‌شده)",
        "tone": "persian"
      },
      {
