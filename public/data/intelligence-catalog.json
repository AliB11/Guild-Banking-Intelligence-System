  "briefing": {
    "period": "1405-05",
    "periodLabel": "مرداد ۱۴۰۵",
    "headline": "مرداد ۱۴۰۵: رشد مبلغ شبکه شاپرک",
    "narrative": [
      "آخرین ماهنامه منتشرشده شاپرک مرداد ۱۴۰۵ (گزارش ۱۳۴) است. گردش شبکه ۳٬۶۵۴ همت و تعداد تراکنش ۴٫۶۵ میلیارد نقل شده است. شهریور در تقویم جاری است اما گزارش آن منتشر نشده.",
