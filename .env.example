# PostgreSQL connection string used by Next.js, Drizzle and migrations.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gbi

# Keep true for a zero-configuration GitHub/Vercel preview.
# Set false in production so a missing database fails closed.
ALLOW_DEMO_MODE=true

# Keep this low on serverless Postgres providers (Neon/Supabase/etc.).
DB_POOL_MAX=5

# Only the container entrypoint should enable this; migrations are non-destructive.
RUN_DB_MIGRATIONS=false
