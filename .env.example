# GBI — متغیرهای محیطی
#
# حالت اصلی (استاتیک / GitHub Pages / npm run dev / npm start بدون دیتابیس)
# هیچ متغیری نیاز ندارد؛ همه مقادیر زیر فقط برای حالت full-stack اختیاری
# (Node server + PostgreSQL) کاربرد دارند.

# connection string PostgreSQL — فقط حالت full-stack
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gbi

# true: بدون دیتابیس، سرور API از corpus درون‌حافظه‌ای پاسخ می‌دهد
# false: نبود دیتابیس خطا می‌دهد (فایلهای استاتیک اصلاً به این متغیر وابسته نیستند)
ALLOW_DEMO_MODE=true

# سقف connection pool برای PostgreSQL (برای serverless معمولاً 5)
DB_POOL_MAX=5

# فقط entrypoint container با true، migrationهای commit‌شده را هنگام start اجرا می‌کند
RUN_DB_MIGRATIONS=false
